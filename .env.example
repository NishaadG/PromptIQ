# Copy to .env.local. Every variable is optional for local development.

# --- Database -------------------------------------------------------------------------------
# Unset: embedded PGlite stored in .data/pglite (local only). Set: any Postgres (e.g. free Neon).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DB_AUTO_MIGRATE=true

# --- Model used to run learners' prompts ------------------------------------------------------
# simulated = offline and free (default). openai = any OpenAI-compatible endpoint.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama
# LLM_MODEL=qwen2.5:1.5b
# LLM_API_KEY=

# --- Local Lab "local" model (unset: simulated 3B model) -------------------------------------
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:1.5b
# CLOUD_USD_PER_MTOK=5

# --- Certificates (required in production; dev auto-generates .data/signing-key.pem) ---------
# PROMPTIQ_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
